<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>interface_jonas_web</name>
  <version>0.0.0</version>
  <description>Web interface for tablet control of the Jonas robot through ROS 2 Humble and rosbridge.</description>
  <maintainer email="mpuchuri@utec.edu.pe">mpuchuri</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://www.utec.edu.pe</url>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ament_index_python</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
